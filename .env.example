# ====================================================================
# EcoVision AI - Environment Configuration Template
# WeMakeDevs × AWS Environmental Hacks Hackathon (Track 03: Waste and Energy)
# ====================================================================

# --------------------------------------------------------------------
# 1. Google Gemini Multimodal Vision API (Required for AI scanning)
# --------------------------------------------------------------------
# Get your free Gemini API key from Google AI Studio:
# https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# --------------------------------------------------------------------
# 2. Amazon S3 Cloud Storage Configuration
# --------------------------------------------------------------------
# Region where your private S3 bucket was created (e.g. ap-south-1, us-east-1)
AWS_REGION=ap-south-1

# Your private Amazon S3 bucket name
AWS_S3_BUCKET=ecovision-ai-waste-images-2026

# --------------------------------------------------------------------
# 3. Authentication Mode
# --------------------------------------------------------------------
# Mode A: Local Development (Reads from ~/.aws/credentials via AWS CLI profile)
AWS_PROFILE=ecovision-local

# Mode B: Production / Vercel Serverless (Configure in Vercel Environment Variables)
# Dedicated IAM user credentials with least-privilege (s3:PutObject, s3:GetObject on scans/*)
# Leave empty in local development if using AWS_PROFILE.
# Set these in Vercel Project Settings > Environment Variables:
# AWS_ACCESS_KEY_ID=your_iam_access_key_id_here
# AWS_SECRET_ACCESS_KEY=your_iam_secret_access_key_here
